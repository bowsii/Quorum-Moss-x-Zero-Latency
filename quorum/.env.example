# Quorum Configuration (Zero-Budget Free-Tier Stack)
SECRET_KEY=dev_secret_key_quorum_32bytes_min_jwt_token_development
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Inference Provider Keys (Free-tier)
GROQ_API_KEY=
OPENROUTER_API_KEY=
HF_API_KEY=
TAVILY_API_KEY=

# Transport: LiveKit (Free tier / local OSS server)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Storage
DATABASE_URL=sqlite+aiosqlite:///./quorum.db
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/quorum
MOSS_CLAIMS_NAMESPACE=quorum_claims
MOSS_FINDINGS_NAMESPACE=quorum_findings

# Reaper Settings
HEARTBEAT_TTL_SECONDS=15
REAPER_SCAN_INTERVAL_SECONDS=1
ENVIRONMENT=development
FRONTEND_URL=https://quorum-frontend.vercel.app
